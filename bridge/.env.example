# Public https origin of this deployment (no path). Required.
BRIDGE_PUBLIC_URL=https://lucy-bridge.vercel.app
# Bearer token the lucy-ping mod sends on POST /ping. Generate: openssl rand -base64 32
BRIDGE_PING_TOKEN=
# Passphrase you type on the OAuth consent page when ChatGPT connects. Required.
OWNER_PASSPHRASE=
# Principal id tokens and subscriptions are bound to. Default: owner
OWNER_SUBJECT=ryan
# Upstash Redis (Vercel Marketplace). Required on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional overrides (defaults shown):
# ALLOWED_REDIRECT_HOSTS=chatgpt.com
# ALLOWED_CALLBACK_HOSTS=            (empty = any public https host)
# ALLOWED_CLIENT_ID_PATTERNS=^https://chatgpt\.com/oauth/client\.json$,^https://chatgpt\.com/oauth/[A-Za-z0-9_-]+/client\.json$
# MCP_STRICT_HEADERS=0
